# The ONLY settings the hosted demo needs. No keys, no passwords, nothing secret: safe to keep in git.
# This IS the demo's backend/.env, committed on purpose. The main project's own backend/.env is never read or copied (refresh.sh).

# Replay the recorded model replies. Nothing is ever sent to a model, so this site can cost nothing and needs no key.
APP_MODE=replay
REPLAY_SET=demo

# The one and only person on the Users list: an Administrator with every role. Everyone who opens the site is this person (refresh.sh puts the name in the page, so
# the "who are you" question never appears). index.py builds the demo project as this person: keep the two in step.
ADMIN_NAME=demo-user

# Vercel's only writable folder is /tmp. The database is built there, empty, each time a new copy of the app starts (see README.md).
DATA_DIR=/tmp/sdlc-workbench

# Pinned so a recording is always matched: these two are part of every recorded request (same values the recorder uses).
AGENT_MAX_OUTPUT_TOKENS=16000
REVIEW_MAX_OUTPUT_TOKENS=16000

# The model names are part of every recorded request too (a recording is only replayed when the whole request is identical), and the code's own defaults are blank,
# so they have to be here. Same values as backend/.env.example and the recorder. These are names, not keys.
IBM_ICA_MODEL_ID=claude-sonnet-5-5
IBM_ICA_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_HAIKU_MODEL_ID=claude-haiku-5-5
IBM_ICA_HAIKU_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_OPENAI_MODEL_ID=gpt-6.1-sol
IBM_ICA_OPENAI_FALLBACK_MODEL_ID=claude-sonnet-5-5
IBM_ICA_GEMINI_MODEL_ID=gemini-3.7-flash
IBM_ICA_GEMINI_FALLBACK_MODEL_ID=claude-sonnet-5-5

# Prices, so the usage page reads the same as on the working copy (the demo spends nothing).
IBM_ICA_PRICE_INPUT_PER_MTOK=2.00
IBM_ICA_PRICE_OUTPUT_PER_MTOK=10.00
IBM_ICA_HAIKU_PRICE_INPUT_PER_MTOK=0.10
IBM_ICA_HAIKU_PRICE_OUTPUT_PER_MTOK=0.50
IBM_ICA_OPENAI_PRICE_INPUT_PER_MTOK=2.00
IBM_ICA_OPENAI_PRICE_OUTPUT_PER_MTOK=10.00
